#!/usr/bin/env bash
# Bootstrap du nœud k3s — rendu par Terraform (templatefile) et exécuté par
# google-startup-scripts à chaque démarrage de la VM : le script est idempotent.
# Il installe k3s, prépare les variables du cluster et installe FluxCD ; tout
# le reste (cert-manager, applications...) est déployé par Flux depuis manifest/.
# Logs : /var/log/k3s-bootstrap.log
set -euo pipefail
exec > >(tee -a /var/log/k3s-bootstrap.log) 2>&1

EXTERNAL_IP="${external_ip}"
K3S_CHANNEL="${k3s_channel}"
K3S_VERSION="${k3s_version}"
FLUX_VERSION="${flux_version}"
FLUX_GIT_URL="${flux_git_url}"
FLUX_BRANCH="${flux_branch}"

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

log() { echo "[$(date -Is)] $*"; }

# Réessaie une commande jusqu'à ce qu'elle réussisse (max $1 secondes).
retry() {
  local timeout=$1; shift
  local start=$SECONDS
  until "$@" >/dev/null 2>&1; do
    if (( SECONDS - start > timeout )); then
      log "Timeout ($${timeout}s) : $*"
      return 1
    fi
    sleep 5
  done
}

log "=== Bootstrap k3s (IP publique : $EXTERNAL_IP) ==="

# --- Limites inotify ----------------------------------------------------------
# Les défauts d'Ubuntu (128 instances) sont vite atteints avec Flux, Alloy, Prometheus,
# les config-reloader... : erreur "failed to create fsnotify watcher: too many open files".
# Appliqué tout de suite (sysctl) et persistant au reboot (sysctl.d).
cat > /etc/sysctl.d/99-k3s-inotify.conf <<EOF
fs.inotify.max_user_instances = 1024
fs.inotify.max_user_watches = 524288
EOF
sysctl -q -p /etc/sysctl.d/99-k3s-inotify.conf

# --- Configuration k3s -------------------------------------------------------
# tls-san : le certificat de l'API inclut l'IP publique (kubectl depuis l'extérieur).
# Ne PAS définir node-external-ip : k3s l'utiliserait comme advertise-address de
# l'API, et les pods joindraient alors l'API (10.43.0.1) via l'IP publique,
# bloquée par le firewall GCP sur le port 6443 (timeout).
mkdir -p /etc/rancher/k3s
CONFIG_CHANGED=false
cat > /etc/rancher/k3s/config.yaml.new <<EOF
write-kubeconfig-mode: "0600"
tls-san:
  - "$EXTERNAL_IP"
EOF
if ! cmp -s /etc/rancher/k3s/config.yaml.new /etc/rancher/k3s/config.yaml; then
  mv /etc/rancher/k3s/config.yaml.new /etc/rancher/k3s/config.yaml
  CONFIG_CHANGED=true
else
  rm -f /etc/rancher/k3s/config.yaml.new
fi

# --- Installation k3s --------------------------------------------------------
if ! command -v k3s >/dev/null 2>&1; then
  log "Installation de k3s (canal=$K3S_CHANNEL version=$${K3S_VERSION:-<canal>})"
  curl -sfL https://get.k3s.io \
    | INSTALL_K3S_CHANNEL="$K3S_CHANNEL" INSTALL_K3S_VERSION="$K3S_VERSION" sh -s - server
elif [[ "$CONFIG_CHANGED" == "true" ]]; then
  log "Configuration k3s modifiée, redémarrage du service"
  systemctl restart k3s
else
  log "k3s déjà installé ($(k3s --version | head -n1))"
fi

log "Attente du nœud Kubernetes"
retry 300 k3s kubectl get nodes
retry 300 k3s kubectl wait --for=condition=Ready node --all --timeout=10s

# --- Variables du cluster pour Flux -------------------------------------------
# Les Kustomizations Flux les injectent dans les manifests (postBuild.substituteFrom),
# ex : host d'Ingress "whoami.$${INGRESS_BASE_DOMAIN}".
log "Création de la ConfigMap flux-system/cluster-vars"
cat > /etc/rancher/k3s/cluster-vars.yaml <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: flux-system
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-vars
  namespace: flux-system
data:
  EXTERNAL_IP: "$EXTERNAL_IP"
  INGRESS_BASE_DOMAIN: "$EXTERNAL_IP.sslip.io"
EOF
retry 300 k3s kubectl apply -f /etc/rancher/k3s/cluster-vars.yaml

# --- FluxCD -------------------------------------------------------------------
# Installation initiale uniquement : ensuite Flux se gère lui-même depuis le repo
# (manifest/flux-system/gotk-components.yaml et gotk-sync.yaml).
if [[ -n "$FLUX_GIT_URL" ]] && ! k3s kubectl -n flux-system get gitrepository flux-system >/dev/null 2>&1; then
  log "Installation de Flux $FLUX_VERSION"
  curl -sfL --retry 5 -o /etc/rancher/k3s/flux-install.yaml \
    "https://github.com/fluxcd/flux2/releases/download/$FLUX_VERSION/install.yaml"
  retry 300 k3s kubectl apply --server-side -f /etc/rancher/k3s/flux-install.yaml
  retry 600 k3s kubectl -n flux-system wait --for=condition=Available deployment --all --timeout=10s

  log "Synchronisation de Flux sur $FLUX_GIT_URL ($FLUX_BRANCH)"
  cat > /etc/rancher/k3s/flux-sync.yaml <<EOF
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 1m0s
  ref:
    branch: $FLUX_BRANCH
  url: $FLUX_GIT_URL
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 10m0s
  path: ./manifest/flux-system
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
EOF
  retry 300 k3s kubectl apply -f /etc/rancher/k3s/flux-sync.yaml
fi

log "=== Bootstrap terminé ==="
